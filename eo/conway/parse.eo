# Command-line arguments read into a grid size, a number of generations
# and the list of cells that start the game alive.

+architect yegor256@gmail.com
+home https://github.com/objectionary/game-of-life
+package conway
+spdx SPDX-FileCopyrightText: Copyright (c) 2022 Anton Shatokhin
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[args] > parse
  args > @

  [^ key id] > keyPos
    if. > @
      id.lt ^.args.length
      if.
        (^.args.at id).eq key
        id
        ^.keyPos key (id.plus 1)
      -1

  [^] > dims
    if. > @
      pos.lt 0
      * 3 3
      "%dx%d".scanf (^.args.at (pos.plus 1))
    ^.keyPos "size" 0 > pos

  [^] > rows
    ^.dims.at 0 > @

  [^] > cols
    ^.dims.at 1 > @

  [^] > cycle
    if. > @
      pos.lt 0
      10
      ("%d".scanf (^.args.at (pos.plus 1))).at 0
    ^.keyPos "cycle" 0 > pos

  [^ text] > pair
    if. > @
      and.
        and.
          (raw.at 0).gt 0
          (raw.at 1).gt 0
        and.
          ((raw.at 0).gt ^.rows).not
          ((raw.at 1).gt ^.cols).not
      * ((raw.at 0).minus 1) ((raw.at 1).minus 1)
      T "Put coordinate is outside the grid"
    "%dx%d".scanf text > raw

  [^ id acc] > putsFrom
    if. > @
      id.lt ^.args.length
      if.
        (^.args.at id).eq "put"
        ^.putsFrom (id.plus 2) (acc.with (^.pair (^.args.at (id.plus 1))))
        ^.putsFrom (id.plus 1) acc
      acc

  [^] > puts
    ^.putsFrom 0 * > @

  [] +> reads-rows-from-size
    eq. > @
      (parse (* "size" "4x5")).rows
      4

  [] +> reads-cols-from-size
    eq. > @
      (parse (* "size" "4x5")).cols
      5

  [] +> reads-cycle-count
    eq. > @
      (parse (* "cycle" "7")).cycle
      7

  [] +> converts-put-to-zero-based
    eq. > @
      ((parse (* "put" "2x3")).puts.at 0).at 0
      1

  (((parse (* "size" "2x3")).pair "0x1").at 0).eq 0 --> stops-on-zero-row

  (((parse (* "size" "2x3")).pair "1x0").at 1).eq 0 --> stops-on-zero-column

  (((parse (* "size" "2x3")).pair "-1x1").at 0).eq 0 --> stops-on-negative-row

  (((parse (* "size" "2x3")).pair "1x-1").at 1).eq 0 --> stops-on-negative-column

  (((parse (* "size" "2x3")).pair "3x1").at 0).eq 0 --> stops-on-row-beyond-grid

  (((parse (* "size" "2x3")).pair "1x4").at 1).eq 0 --> stops-on-column-beyond-grid

  (((parse (* "put" "0x1")).puts.at 0).at 0).eq 0 --> stops-on-out-of-range-put

  [] +> accepts-first-cell
    eq. > @
      ((parse *).pair "1x1").at 0
      0

  [] +> accepts-last-row
    eq. > @
      ((parse *).pair "3x3").at 0
      2

  [] +> accepts-last-column
    eq. > @
      ((parse *).pair "3x3").at 1
      2
